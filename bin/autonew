#!/usr/bin/env python3
"""
autonew - Send /new command to a provider's terminal pane to start a new session.

Usage:
    autonew <provider>

Providers:
    gemini, codex, opencode, droid, claude

This command directly sends '/new' to the provider's terminal pane
without any context injection or protocol wrapping.
"""

from __future__ import annotations

import json
import os
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
sys.path.insert(0, str(lib_dir))

from cli_output import EXIT_ERROR, EXIT_OK
from pane_registry import load_registry_by_project_id, _get_providers_map
from project_id import compute_ccb_project_id
from terminal import get_backend_for_session


# Provider to reset command mapping
PROVIDER_COMMANDS = {
    "gemini": "/clear",
    "codex": "/new",
    "opencode": "/new",
    "droid": "/new",
    "claude": "/new",
}


def _usage() -> None:
    print("Usage: autonew <provider>", file=sys.stderr)
    print("", file=sys.stderr)
    print("Providers:", file=sys.stderr)
    print("  gemini, codex, opencode, droid, claude", file=sys.stderr)
    print("", file=sys.stderr)
    print("Sends /new to the provider's pane to start a new session.", file=sys.stderr)


def _predismiss_codex_update_prompt(provider: str) -> None:
    # Best-effort only: this touches Codex's internal update state and may
    # stop working if upstream changes the schema.
    if provider != "codex":
        return
    try:
        version_file = Path.home() / ".codex" / "version.json"
        if not version_file.exists():
            return
        payload = json.loads(version_file.read_text(encoding="utf-8"))
        latest = str(payload.get("latest_version") or "").strip()
        if latest and str(payload.get("dismissed_version") or "").strip() != latest:
            payload["dismissed_version"] = latest
            version_file.write_text(json.dumps(payload), encoding="utf-8")
    except Exception:
        pass


def _run_capture(cmd: list[str], timeout: float = 5.0) -> str:
    try:
        cp = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=timeout,
            check=False,
        )
        return cp.stdout or ""
    except Exception:
        return ""


def _pkill_patterns(patterns: list[str]) -> int:
    """Legacy pkill-based cleanup. Kept as fallback but prefer _kill_stale_tasks."""
    killed = 0
    for pattern in patterns:
        try:
            cp = subprocess.run(["pkill", "-f", pattern], check=False)
            if cp.returncode == 0:
                killed += 1
        except Exception:
            pass
    return killed


def _kill_stale_tasks(provider: str, work_dir: str = "", max_age_s: float = 0.0) -> int:
    """Kill stale async task wrapper processes for a specific provider.

    Scoped by: provider name, project work_dir, process age, excludes own process tree.
    Uses os.killpg() to kill the entire process group (wrapper + child ask --foreground).
    Linux/WSL only -- relies on .sh companion scripts and os.killpg().
    """
    import signal as _signal
    killed = 0
    task_dir = Path("/tmp/ccb-tasks")
    if not task_dir.exists():
        return 0
    my_pid = os.getpid()
    my_ppid = os.getppid()
    now = time.time()
    for status_file in sorted(task_dir.glob(f"ask-{provider}-*.status")):
        try:
            file_age = now - status_file.stat().st_mtime
            if max_age_s > 0 and file_age < max_age_s:
                continue
            text = status_file.read_text(encoding="utf-8", errors="replace")
            if "finished" in text or "failed" in text:
                continue
            # Scope by work_dir: check the companion .sh script
            if work_dir:
                sh_file = status_file.with_suffix(".sh")
                if sh_file.exists():
                    sh_text = sh_file.read_text(encoding="utf-8", errors="replace")
                    if work_dir not in sh_text:
                        continue  # Different project, skip
            for line in text.splitlines():
                if "spawned pid=" in line:
                    pid_str = line.split("spawned pid=")[1].strip().split()[0]
                    pid = int(pid_str)
                    if pid in (my_pid, my_ppid, 0, 1):
                        continue
                    try:
                        os.kill(pid, 0)  # Check alive
                        try:
                            os.killpg(os.getpgid(pid), _signal.SIGTERM)
                        except OSError:
                            os.kill(pid, _signal.SIGTERM)
                        killed += 1
                    except OSError:
                        pass
        except Exception:
            pass
    return killed


def _kill_stuck_askd_workers(provider: str, work_dir: str = "") -> int:
    """Kill the askd worker holding this project's ProviderLock for *provider*.

    After autonew, the old askd worker may still hold the fcntl lock on
    ~/.ccb/run/{provider}-{hash}.lock, causing all new /ask requests to
    queue behind it.  This function derives the exact lock file using the
    same session-key logic the adapter uses, then kills the holder.

    Currently only the OpenCode adapter uses ProviderLock (keyed by
    "session:{provider}:{ccb_project_id}").  For other providers the
    function is a harmless no-op.
    """
    import hashlib as _hashlib
    import signal as _signal

    lock_dir = Path.home() / ".ccb" / "run"
    if not lock_dir.exists():
        return 0

    # Derive the exact lock file using the same scope as the adapter.
    # OpenCode adapter: ProviderLock("opencode", cwd=f"session:{session_key}")
    # where session_key = f"opencode:{ccb_project_id}"
    wd = Path(work_dir or os.getcwd())
    try:
        project_id = compute_ccb_project_id(wd)
    except Exception:
        return 0

    session_key = f"{provider}:{project_id}"
    lock_cwd = f"session:{session_key}"
    cwd_hash = _hashlib.md5(lock_cwd.encode()).hexdigest()[:8]
    lock_file = lock_dir / f"{provider}-{cwd_hash}.lock"

    if not lock_file.exists():
        return 0

    # Read the PID holding the lock
    try:
        content = lock_file.read_text(encoding="utf-8", errors="replace").strip()
        if not content:
            return 0
        holder_pid = int(content)
    except (ValueError, OSError):
        return 0

    my_pid = os.getpid()
    my_ppid = os.getppid()
    if holder_pid in (my_pid, my_ppid, 0, 1):
        return 0

    # Check if holder is alive
    try:
        os.kill(holder_pid, 0)
    except OSError:
        # Dead PID -- clean up stale lock file
        try:
            lock_file.unlink()
        except OSError:
            pass
        return 0

    # Holder is alive -- kill it so new askd can take over
    try:
        os.kill(holder_pid, _signal.SIGTERM)
    except OSError:
        return 0

    # Give it a moment, then force-kill if needed
    time.sleep(0.5)
    try:
        os.kill(holder_pid, 0)  # Still alive?
        os.kill(holder_pid, _signal.SIGKILL)
    except OSError:
        pass

    # Only unlink if the file still contains the same PID we killed
    # (avoids race where a new askd acquired the lock in the meantime)
    time.sleep(0.2)
    try:
        current_content = lock_file.read_text(encoding="utf-8", errors="replace").strip()
        if current_content and int(current_content) == holder_pid:
            lock_file.unlink()
    except (ValueError, OSError):
        pass

    return 1


def _opencode_db_latest_session() -> tuple[str | None, int]:
    db_path = Path.home() / ".local" / "share" / "opencode" / "opencode.db"
    if not db_path.exists():
        return None, 0
    try:
        conn = sqlite3.connect(str(db_path))
        cur = conn.cursor()
        row = cur.execute(
            "SELECT id, time_created FROM session ORDER BY time_created DESC LIMIT 1"
        ).fetchone()
        conn.close()
        if not row:
            return None, 0
        return str(row[0]), int(row[1] or 0)
    except Exception:
        return None, 0


def _opencode_wait_for_new_session(previous_ts: int, timeout_s: float = 15.0) -> str | None:
    deadline = time.time() + timeout_s
    latest_id = None
    while time.time() < deadline:
        sid, created = _opencode_db_latest_session()
        if sid:
            latest_id = sid
        if sid and created > previous_ts:
            return sid
        time.sleep(0.5)
    return latest_id


def _update_opencode_session_file(session_file: Path, *, pane_id: str, opencode_session_id: str | None) -> None:
    data = {}
    if session_file.exists():
        try:
            data = json.loads(session_file.read_text(encoding="utf-8-sig"))
        except Exception:
            data = {}
    if not isinstance(data, dict):
        data = {}
    data["pane_id"] = pane_id
    if opencode_session_id:
        data["opencode_session_id"] = opencode_session_id
    data["updated_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
    session_file.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def _codex_latest_log(work_dir: Path) -> Path | None:
    try:
        from codex_comm import CodexLogReader

        return CodexLogReader(log_path=None, session_id_filter=None, work_dir=work_dir).current_log_path()
    except Exception:
        return None


def _codex_log_identity(log_path: Path | None) -> tuple[str, float]:
    if not log_path:
        return "", 0.0
    try:
        return str(log_path), float(log_path.stat().st_mtime)
    except Exception:
        return str(log_path), 0.0


def _wait_for_new_codex_log(work_dir: Path, before_path: str, before_mtime: float, timeout_s: float = 15.0) -> Path | None:
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        latest = _codex_latest_log(work_dir)
        if latest:
            latest_path, latest_mtime = _codex_log_identity(latest)
            if latest_path != before_path or latest_mtime > before_mtime:
                return latest
        time.sleep(0.5)
    # Do NOT return stale latest_seen — let Method 2 (pane parsing) handle it
    return None


def _parse_session_id_from_pane(backend, pane_id: str, timeout_s: float = 12.0) -> str | None:
    """Poll the pane content for 'codex resume <session-id>' and return the session ID.

    This is more robust than log-file detection after codex-switch, because
    the pane always shows the session ID in its banner regardless of log timing.
    """
    deadline = time.time() + timeout_s
    seen_ids: list[str] = []
    while time.time() < deadline:
        try:
            import re
            capture = _run_capture(["tmux", "capture-pane", "-t", pane_id, "-p", "-S", "-60"], timeout=3.0)
            # UUIDs may be split across lines by tmux or codex output wrapping.
            # Join lines so the regex can match the full UUID.
            capture_joined = capture.replace("\n", "")
            # Find ALL 'codex resume <uuid>' lines — the LAST one is the newest session
            matches = re.findall(r'codex resume ([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})', capture_joined)
            if matches:
                latest = matches[-1]
                if latest not in seen_ids:
                    seen_ids.append(latest)
                # Wait a beat to confirm no newer session is starting
                if len(seen_ids) >= 1:
                    return seen_ids[-1]
        except Exception:
            pass
        time.sleep(1.0)
    return seen_ids[-1] if seen_ids else None


def _find_codex_log_by_session_id(session_id: str) -> Path | None:
    """Find the rollout log file for a given Codex session ID."""
    if not session_id:
        return None
    codex_sessions = Path.home() / ".codex" / "sessions"
    if not codex_sessions.exists():
        return None
    # Session logs are stored as ~/.codex/sessions/YYYY/MM/DD/rollout-*-<session-id>.jsonl
    for log_file in codex_sessions.rglob(f"*{session_id}*"):
        if log_file.is_file():
            return log_file
    return None


def _kill_stale_codex_tasks(work_dir: str) -> int:
    """Kill stale async codex task processes for this project."""
    killed = _kill_stale_tasks("codex", work_dir=work_dir, max_age_s=0.0)
    return killed


def _handle_codex_autonew(work_dir: Path, session, backend, pane_id: str) -> tuple[bool, str]:
    # Kill stuck askd workers holding the Codex provider lock
    _kill_stuck_askd_workers("codex", work_dir=str(work_dir))

    # Also kill stale task processes that may hold stale session state
    stale_killed = _kill_stale_codex_tasks(str(work_dir))

    before_log = _codex_latest_log(work_dir)
    before_path, before_mtime = _codex_log_identity(before_log)

    session.request_codex_refresh(clear_binding=False)

    try:
        backend.send_text(pane_id, "/new")
    except Exception as exc:
        return False, f"Failed to send /new: {exc}"

    # Method 1: Watch for a new log file (fast path)
    new_log = _wait_for_new_codex_log(work_dir, before_path, before_mtime, timeout_s=15.0)
    if new_log:
        try:
            from codex_comm import CodexCommunicator

            session_id = CodexCommunicator._extract_session_id(new_log)
        except Exception:
            session_id = None
        session.update_codex_log_binding(log_path=str(new_log), session_id=session_id)
        session.clear_codex_refresh_request()
        return True, (
            f"Codex /new sent to {pane_id}; rebound to "
            f"{session_id or 'unknown-session'}"
        )

    # Method 2 (fallback): Parse session ID directly from the pane content.
    # This handles the post-codex-switch case where the log file detection
    # fails because codex-switch already created a new session and log.
    pane_session_id = _parse_session_id_from_pane(backend, pane_id, timeout_s=12.0)
    if pane_session_id:
        # Try to find the corresponding log file
        log_path = _find_codex_log_by_session_id(pane_session_id)
        session.update_codex_log_binding(
            log_path=str(log_path) if log_path else None,
            session_id=pane_session_id,
        )
        session.clear_codex_refresh_request()
        return True, (
            f"Codex /new sent to {pane_id}; rebound to "
            f"{pane_session_id} (from pane, log={'found' if log_path else 'pending'})"
            + (f"; killed {stale_killed} stale tasks" if stale_killed else "")
        )

    # Method 3 (last resort): Request refresh and let askd rebind on next request.
    session.request_codex_refresh(clear_binding=True)
    return True, (
        f"Codex /new sent to {pane_id}; waiting for next askd request to rebind session"
        + (f"; killed {stale_killed} stale tasks" if stale_killed else "")
    )


def _handle_opencode_autonew(work_dir: Path, record: dict, provider_entry: dict, backend, pane_id: str) -> tuple[bool, str]:
    killed_wrappers = _kill_stale_tasks("opencode", work_dir=str(work_dir))
    killed_askd = _kill_stuck_askd_workers("opencode", work_dir=str(work_dir))

    if not pane_id:
        return False, "No OpenCode pane bound to this project"

    # Strict project isolation: refuse to send /new to a pane whose CWD
    # does not belong to the calling project. This prevents cross-project
    # interference where project A's autonew hits project B's pane.
    cwd_check = getattr(backend, "pane_belongs_to_cwd", None)
    if callable(cwd_check):
        try:
            if not cwd_check(pane_id, str(work_dir)):
                return False, (
                    f"Refusing to send /new to pane {pane_id}: "
                    f"pane does not belong to project {work_dir}"
                )
        except Exception:
            pass

    before_sid, before_ts = _opencode_db_latest_session()

    try:
        backend.send_text(pane_id, "/new")
    except Exception as exc:
        return False, f"Failed to send /new: {exc}"

    new_sid = _opencode_wait_for_new_session(before_ts, timeout_s=15.0)

    session_file_path = str(provider_entry.get("session_file") or "").strip()
    if not session_file_path:
        session_file_path = str(work_dir / ".ccb" / ".opencode-session")
    session_file = Path(session_file_path)
    _update_opencode_session_file(session_file, pane_id=pane_id, opencode_session_id=new_sid or before_sid)

    msg = (
        f"OpenCode /new sent to {pane_id}; "
        f"session_id={'unknown' if not (new_sid or before_sid) else (new_sid or before_sid)}; "
        f"killed_wrappers={killed_wrappers}; killed_askd={killed_askd}"
    )
    return True, msg


def main(argv: list[str]) -> int:
    if len(argv) <= 1:
        _usage()
        return EXIT_ERROR

    provider = argv[1].lower()

    if provider in ("-h", "--help"):
        _usage()
        return EXIT_OK

    if provider not in PROVIDER_COMMANDS:
        print(f"[ERROR] Unknown provider: {provider}", file=sys.stderr)
        print(f"[ERROR] Available: {', '.join(sorted(PROVIDER_COMMANDS.keys()))}", file=sys.stderr)
        return EXIT_ERROR

    # Get current project ID
    work_dir = Path(os.getcwd())
    try:
        project_id = compute_ccb_project_id(work_dir)
    except Exception as e:
        print(f"[ERROR] Failed to compute project ID: {e}", file=sys.stderr)
        return EXIT_ERROR

    # Load registry for this project and provider
    record = load_registry_by_project_id(project_id, provider)
    if not record:
        print(f"[ERROR] No active {provider} session found for this project.", file=sys.stderr)
        return EXIT_ERROR

    # Get provider's pane_id
    providers_map = _get_providers_map(record)
    provider_entry = providers_map.get(provider, {})
    pane_id = str(provider_entry.get("pane_id") or "").strip()

    if not pane_id:
        print(f"[ERROR] No pane_id found for {provider}.", file=sys.stderr)
        return EXIT_ERROR

    # Get terminal backend
    backend = get_backend_for_session(record)
    if not backend:
        print("[ERROR] Terminal backend not available.", file=sys.stderr)
        return EXIT_ERROR

    # Use ensure_pane() to handle stale bindings before sending /new
    session_loaders = {
        "codex": ("caskd_session", "load_project_session"),
        "gemini": ("gaskd_session", "load_project_session"),
        "opencode": ("oaskd_session", "load_project_session"),
        "droid": ("daskd_session", "load_project_session"),
        "claude": ("laskd_session", "load_project_session"),
    }
    loader_info = session_loaders.get(provider)
    session = None
    if loader_info:
        try:
            mod = __import__(loader_info[0])
            loader = getattr(mod, loader_info[1])
            session = loader(work_dir)
            if session:
                ok, pane_or_err = session.ensure_pane()
                if ok:
                    pane_id = pane_or_err
                else:
                    print(f"[ERROR] Could not ensure pane for {provider}: {pane_or_err}", file=sys.stderr)
                    return EXIT_ERROR
            else:
                print(f"[ERROR] No session loaded for {provider}.", file=sys.stderr)
                return EXIT_ERROR
        except Exception as e:
            # Fallback to basic alive check if session loader fails
            print(f"[WARN] ensure_pane failed ({e}), trying basic alive check", file=sys.stderr)
            try:
                if not backend.is_alive(pane_id):
                    print(f"[ERROR] {provider} pane {pane_id} is not alive.", file=sys.stderr)
                    return EXIT_ERROR
            except Exception as e2:
                print(f"[ERROR] Failed to check pane status: {e2}", file=sys.stderr)
                return EXIT_ERROR
    else:
        # Unknown provider — basic alive check
        try:
            if not backend.is_alive(pane_id):
                print(f"[ERROR] {provider} pane {pane_id} is not alive.", file=sys.stderr)
                return EXIT_ERROR
        except Exception as e:
            print(f"[ERROR] Failed to check pane status: {e}", file=sys.stderr)
            return EXIT_ERROR

    # OpenCode needs stronger session hygiene than the generic /new path.
    if provider == "opencode":
        ok, message = _handle_opencode_autonew(work_dir, record, provider_entry, backend, pane_id)
        if not ok:
            print(f"[ERROR] {message}", file=sys.stderr)
            return EXIT_ERROR
        print(message)
        return EXIT_OK

    if provider == "codex":
        if session is None:
            print("[ERROR] Codex session metadata unavailable; cannot refresh binding after /new.", file=sys.stderr)
            return EXIT_ERROR
        ok, message = _handle_codex_autonew(work_dir, session, backend, pane_id)
        if not ok:
            print(f"[ERROR] {message}", file=sys.stderr)
            return EXIT_ERROR
        print(message)
        return EXIT_OK

    # Kill stuck askd workers for any provider before sending /new
    _kill_stuck_askd_workers(provider, work_dir=str(work_dir))

    # Send reset command to the pane
    reset_cmd = PROVIDER_COMMANDS[provider]
    try:
        _predismiss_codex_update_prompt(provider)
        backend.send_text(pane_id, reset_cmd)
        # Post-send liveness poll. Poll all iterations with no early exit:
        # the hijack case can kill the pane shortly after the send succeeds.
        died_after_send = False
        for _ in range(6):
            time.sleep(0.5)
            try:
                if not backend.is_alive(pane_id):
                    died_after_send = True
                    break
            except Exception:
                pass

        if died_after_send:
            print(f"[WARN] {provider} pane {pane_id} died after send. Recovering...", file=sys.stderr)
            recovered = False
            if loader_info:
                try:
                    session = loader(work_dir)
                    if session:
                        ok, new_pane = session.ensure_pane()
                        if ok:
                            print(f"[OK] Recovered {provider} to pane {new_pane}", file=sys.stderr)
                            time.sleep(3)
                            backend.send_text(new_pane, reset_cmd)
                            recovered = True
                except Exception as e:
                    print(f"[ERROR] Recovery failed: {e}", file=sys.stderr)
            if not recovered:
                print(f"[ERROR] {provider} pane died and could not recover.", file=sys.stderr)
                return EXIT_ERROR
        print(f"Sent {reset_cmd} to {provider} (pane: {pane_id})")
        return EXIT_OK
    except Exception as e:
        print(f"[ERROR] Failed to send {reset_cmd}: {e}", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main(sys.argv))
