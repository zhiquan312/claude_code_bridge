#!/usr/bin/env bash
# ccb-mounted - Check which CCB providers are mounted
# Usage: ccb-mounted [--json|--simple] [--autostart] [path]

set -euo pipefail

PROVIDERS=(codex gemini opencode claude droid)
CWD=$(pwd)
FORMAT="--json"
AUTOSTART=false

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --simple)
      FORMAT="--simple"
      shift
      ;;
    --json)
      FORMAT="--json"
      shift
      ;;
    --autostart)
      AUTOSTART=true
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      CWD="$1"
      shift
      ;;
  esac
done

# Normalize CWD for Windows (convert /e/... to E:/...)
if [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]]; then
  if [[ "$CWD" =~ ^/([a-zA-Z])/ ]]; then
    CWD="${BASH_REMATCH[1]^}:${CWD:2}"
  fi
fi

resolve_session_file() {
  local provider="$1"
  "$PYTHON_BIN" - "$CWD" "$provider" "$LIB_DIR" <<'PY'
import sys
from pathlib import Path

work_dir = Path(sys.argv[1])
provider = sys.argv[2]
lib_dir = Path(sys.argv[3])
sys.path.insert(0, str(lib_dir))

try:
    from session_utils import find_project_session_file
    path = find_project_session_file(work_dir, f".{provider}-session")
except Exception:
    path = None

print("" if path is None else str(path))
PY
}

MOUNTED=()
for provider in "${PROVIDERS[@]}"; do
  session_file="$(resolve_session_file "$provider")"
  if [[ -z "$session_file" ]]; then
    continue
  fi

  PING_ARGS=("$provider" "--session-file" "$session_file")
  if [[ "$AUTOSTART" == true ]]; then
    PING_ARGS+=("--autostart")
  fi

  # Delegate health detection to ccb-ping so mounted stays aligned with
  # unified askd, provider-specific state, and shared session resolution.
  if (cd "$CWD" && "$SCRIPT_DIR/ccb-ping" "${PING_ARGS[@]}") >/dev/null 2>&1; then
    MOUNTED+=("$provider")
  fi
done

case "$FORMAT" in
  --simple)
    echo "${MOUNTED[*]:-}"
    ;;
  --json|*)
    if [[ ${#MOUNTED[@]} -eq 0 ]]; then
      "$PYTHON_BIN" - "$CWD" <<'PY'
import json
import sys

print(json.dumps({"cwd": sys.argv[1], "mounted": []}))
PY
    else
      "$PYTHON_BIN" - "$CWD" "${MOUNTED[@]}" <<'PY'
import json
import sys

print(json.dumps({"cwd": sys.argv[1], "mounted": sys.argv[2:]}))
PY
    fi
    ;;
esac
