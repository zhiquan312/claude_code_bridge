#!/usr/bin/env python3
"""
pend - View latest reply from AI providers.

Usage:
    pend <provider> [N] [--session-file FILE] [--live [LINES]] [--req-id ID]

Providers:
    gemini, codex, opencode, droid, claude

Arguments:
    N              Show the latest N conversations (default: 1)
    --live [LINES] Capture live terminal pane output (default: 50 lines)
    --req-id ID    Check task state in journal; suppress stale output if still running
"""

import json as _json
import sys
import os
import subprocess
from pathlib import Path
from typing import Optional

script_dir = Path(__file__).resolve().parent
_lib_dir = script_dir.parent / "lib"
if str(_lib_dir) not in sys.path:
    sys.path.insert(0, str(_lib_dir))


# Provider to original pend command mapping
PROVIDER_PENDS = {
    "gemini": "gpend",
    "codex": "cpend",
    "opencode": "opend",
    "droid": "dpend",
    "claude": "lpend",
}

SESSION_FILES = {
    "codex": ".codex-session",
    "gemini": ".gemini-session",
    "opencode": ".opencode-session",
    "droid": ".droid-session",
    "claude": ".claude-session",
}


def _usage():
    print("Usage: pend <provider> [N] [--session-file FILE] [--live [LINES]] [--req-id ID]", file=sys.stderr)
    print("", file=sys.stderr)
    print("Providers:", file=sys.stderr)
    print("  gemini, codex, opencode, droid, claude", file=sys.stderr)
    print("", file=sys.stderr)
    print("Flags:", file=sys.stderr)
    print("  --live [N]     Capture live terminal pane (default 50 lines)", file=sys.stderr)
    print("  --req-id ID    Check task state; suppress stale output if running", file=sys.stderr)


def _find_session_file(provider: str) -> Optional[Path]:
    """Walk up from cwd to find .ccb/<provider>-session."""
    sf = SESSION_FILES.get(provider)
    if not sf:
        return None
    p = Path(os.getcwd())
    while p != p.parent:
        candidate = p / ".ccb" / sf
        if candidate.exists():
            return candidate
        p = p.parent
    return None


def _live_capture(provider: str, lines: int = 50) -> int:
    """Capture live terminal pane output using the correct backend (tmux/WezTerm)."""
    session_path = _find_session_file(provider)
    if not session_path:
        print(f"[ERROR] Session file not found for {provider}", file=sys.stderr)
        return 1
    try:
        data = _json.loads(session_path.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"[ERROR] Cannot read session: {e}", file=sys.stderr)
        return 1

    try:
        from terminal import get_backend_for_session, get_pane_id_from_session
        backend = get_backend_for_session(data)
        pane_id = get_pane_id_from_session(data) or data.get("pane_id") or data.get("tmux_pane")
    except ImportError:
        # Fallback to tmux directly if terminal module not available
        backend = None
        pane_id = data.get("pane_id") or data.get("tmux_pane")

    if not pane_id:
        print(f"[ERROR] No pane_id in session file for {provider}", file=sys.stderr)
        return 1

    if backend:
        try:
            text = backend.get_text(pane_id, lines=lines)
            if text:
                print(text)
            return 0
        except Exception as e:
            print(f"[ERROR] Backend capture failed: {e}", file=sys.stderr)
            return 1
    else:
        # Direct tmux fallback
        try:
            result = subprocess.run(
                ["tmux", "capture-pane", "-t", str(pane_id), "-p", "-S", f"-{lines}"],
                capture_output=True, text=True, timeout=5
            )
            print(result.stdout)
            return 0
        except Exception as e:
            print(f"[ERROR] tmux capture failed: {e}", file=sys.stderr)
            return 1


def _check_req_id(req_id: str, provider: str) -> Optional[int]:
    """Check task state. Returns 0 to suppress output, None to fall through to provider pend."""
    try:
        from task_journal import TaskJournal, TaskState
    except ImportError:
        print(f"[WARN] task_journal not available, skipping req_id check")
        return None
    journal = TaskJournal()
    state = journal.get_latest_state(req_id)
    if state is None:
        print(f"[WARN] No journal entry for req_id={req_id}")
        return None  # Fall through to normal pend
    if state in (TaskState.QUEUED, TaskState.RUNNING):
        print(f"Task {req_id}: {state.value} -- still in progress, no result yet.")
        print(f"Use 'pend {provider} --live' to see current pane output.")
        return 0  # Suppress: don't show stale output from previous task
    # COMPLETED/FAILED/CANCELLED: show status header, then fall through to provider pend
    print(f"Task {req_id}: {state.value}")
    return None  # Fall through to show actual provider output


def _check_pending_task(provider: str) -> Optional[str]:
    """Check task_journal.jsonl for a running task that hasn't reached terminal state."""
    # task_journal.jsonl lives in the CCB run directory (default ~/.cache/ccb/).
    # Note: CCB_RUN_DIR is shared across projects. The journal stores provider + req_id
    # but not project_id. This means we may warn about tasks from other projects.
    # This is acceptable: a false warning ("task X still running") is far less harmful
    # than showing stale results without any warning. If cross-project false positives
    # become a problem, extend TaskJournal.record() to include project_id.
    run_dir = os.environ.get("CCB_RUN_DIR", "")
    if not run_dir:
        run_dir = str(Path.home() / ".cache" / "ccb")
    journal_path = Path(run_dir) / "task_journal.jsonl"
    if not journal_path.exists():
        return None

    # Track latest state per (provider, req_id) — journal is append-only state transitions
    terminal_states = {"completed", "failed", "cancelled", "expired"}
    latest_by_req: dict[str, str] = {}
    provider_reqs: list[tuple[str, float]] = []

    try:
        with journal_path.open("r", encoding="utf-8") as f:
            for raw_line in f:
                raw_line = raw_line.strip()
                if not raw_line:
                    continue
                try:
                    entry = _json.loads(raw_line)
                except _json.JSONDecodeError:
                    continue
                if not isinstance(entry, dict):
                    continue
                if str(entry.get("provider", "")).lower() != provider:
                    continue
                req_id = str(entry.get("req_id", "")).strip()
                state = str(entry.get("state", "")).strip().lower()
                ts = float(entry.get("timestamp", 0))
                if req_id:
                    latest_by_req[req_id] = state
                    provider_reqs.append((req_id, ts))
    except Exception:
        return None

    # Find the most recent non-terminal task for this provider
    for req_id, _ts in reversed(provider_reqs):
        state = latest_by_req.get(req_id, "")
        if state and state not in terminal_states:
            return req_id
    return None


def main():
    if len(sys.argv) < 2:
        _usage()
        return 1

    provider = sys.argv[1].lower()

    if provider in ("-h", "--help"):
        _usage()
        return 0

    if provider not in PROVIDER_PENDS:
        print(f"[ERROR] Unknown provider: {provider}", file=sys.stderr)
        print(f"[ERROR] Available: {', '.join(PROVIDER_PENDS.keys())}", file=sys.stderr)
        return 1

    # Parse flags
    remaining = list(sys.argv[2:])
    live_mode = "--live" in remaining
    req_id_mode = "--req-id" in remaining

    if live_mode:
        remaining = [a for a in remaining if a != "--live"]
        lines = 50
        for a in list(remaining):
            try:
                lines = int(a)
                remaining.remove(a)
                break
            except ValueError:
                pass
        return _live_capture(provider, lines)

    if req_id_mode:
        idx = remaining.index("--req-id")
        remaining.pop(idx)
        if idx < len(remaining):
            req_id = remaining.pop(idx)
            result = _check_req_id(req_id, provider)
            if result is not None:
                return result  # 0 = suppressed (task still running)
            # None = fall through to show provider output below
        else:
            print("[ERROR] --req-id requires a value", file=sys.stderr)
            return 1

    # Warn if there is a pending task that hasn't returned yet
    pending_task = _check_pending_task(provider)
    if pending_task:
        print(
            f"[WARN] Task {pending_task} is still running for {provider}. "
            f"Result below may be from a PREVIOUS task.",
            file=sys.stderr,
        )

    # Default: delegate to provider-specific pend command
    pend_cmd = PROVIDER_PENDS[provider]
    pend_path = script_dir / pend_cmd

    if not pend_path.exists():
        print(f"[ERROR] Command not found: {pend_path}", file=sys.stderr)
        return 1

    if sys.platform == "win32":
        cmd = [sys.executable, str(pend_path)] + remaining
    else:
        cmd = [str(pend_path)] + remaining

    try:
        result = subprocess.run(cmd)
        return result.returncode
    except Exception as e:
        print(f"[ERROR] {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
